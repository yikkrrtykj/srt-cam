#!/usr/bin/env python3
"""Read-only, on-demand SRT relay traffic snapshot for 10 srt-live-transmit containers.

Requires Python 3, Docker CLI, tcpdump and root/CAP_NET_RAW.
No packet payloads are stored. Bitrates are approximate observed UDP payload rates,
not decoder/video bitrates, SRT connection states, or packet-loss percentages.
"""
import argparse
import datetime
import json
import os
import re
import selectors
import shutil
import signal
import subprocess
import sys
import time
from collections import defaultdict

PORT_RX_BASE = 21110
PORT_TX_BASE = 11110
# tcpdump SLL2 -i any: "ens3  Out IP 1.2.3.4.11114 > 5.6.7.8.65431: UDP, length 1332"
PKT = re.compile(rb"\b(?P<iface>[a-zA-Z0-9_.:-]+)\s+(?P<direction>In|Out)\s+IP\s+"
                 rb"\S+\.(?P<src>\d+)\s+>\s+\S+\.(?P<dst>\d+):\s+UDP,\s+length\s+(?P<length>\d+)")
LOSS = re.compile(r"\bRCV-DROPPED\b|\bSND-DROPPED\b", re.I)


def cmd(args, timeout=3.0):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError):
        return None


def load_config(path):
    cfg = {"directions": {}, "expected_active": []}
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as f:
            v = json.load(f)
        if not isinstance(v, dict):
            raise ValueError("config must be a JSON object")
        cfg.update(v)
    return cfg


def inspect_container(n):
    r = cmd(["docker", "inspect", "-f", "{{.State.Status}}|{{.RestartCount}}", f"srt-cam{n}"])
    if r is None or r.returncode != 0:
        return "NOT_FOUND", "-"
    values = r.stdout.strip().split("|")
    return values[0] if values else "UNKNOWN", values[1] if len(values) > 1 else "-"


def recent_srt_drop(n):
    r = cmd(["docker", "logs", "--since", "120s", "--tail", "100", f"srt-cam{n}"])
    if r is None or r.returncode != 0:
        return "?"
    lines = (r.stdout + "\n" + r.stderr).splitlines()
    return "YES" if any(LOSS.search(line) for line in lines) else "-"


def process_line(line, counters):
    m = PKT.search(line)
    if not m:
        return
    name = m.group("iface").decode("ascii", "replace")
    direction = m.group("direction")
    # Linux 'any' on lo may expose loopback traffic on both receive/transmit.
    # Count the locally delivered 'In' copy only to avoid duplicating it.
    if name == "lo":
        if direction != b"In":
            return
        medium = "LO"
    else:
        medium = "WAN"
        # For WAN interface, input media should arrive from outside; output media goes outside.
    size = int(m.group("length"))
    if size < 500:
        return  # SRT control/handshake generally small; estimate media-sized packets only
    sp = int(m.group("src")); dp = int(m.group("dst"))
    if PORT_RX_BASE+1 <= dp <= PORT_RX_BASE+10:
        if medium == "LO" or direction == b"In":
            counters[dp-PORT_RX_BASE]["rx"] += size
            counters[dp-PORT_RX_BASE]["rx_"+medium] += size
    if PORT_TX_BASE+1 <= sp <= PORT_TX_BASE+10:
        if medium == "LO" or direction == b"Out":
            counters[sp-PORT_TX_BASE]["tx"] += size
            counters[sp-PORT_TX_BASE]["tx_"+medium] += size


def capture(seconds):
    command = ["tcpdump", "-ni", "any", "-q", "-l", "--immediate-mode", "-s", "96",
               "udp and (portrange 11111-11120 or portrange 21111-21120)"]
    p = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0)
    if p.stdout is None:
        raise RuntimeError("tcpdump stdout unavailable")
    selector = selectors.DefaultSelector()
    selector.register(p.stdout, selectors.EVENT_READ)
    data = b""
    seen = defaultdict(lambda: defaultdict(int))
    start = time.monotonic()
    end = start + seconds
    try:
        while time.monotonic() < end:
            remaining = end - time.monotonic()
            for _key, _ in selector.select(timeout=min(0.2, max(0, remaining))):
                chunk = os.read(p.stdout.fileno(), 65536)
                if not chunk:
                    break
                data += chunk
                parts = data.split(b"\n")
                data = parts.pop()
                for part in parts:
                    process_line(part, seen)
                if len(data) > 1024 * 1024:
                    data = b""  # malformed/unbounded line guard
    finally:
        if p.poll() is None:
            p.send_signal(signal.SIGINT)  # stop only tcpdump, never the SRT processes
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            if p.stdout is None:
                break
            readable, _, _ = __import__("select").select([p.stdout], [], [], 0.05)
            if readable:
                chunk = os.read(p.stdout.fileno(), 65536)
                if not chunk:
                    break
                data += chunk
                parts = data.split(b"\n")
                data = parts.pop()
                for part in parts:
                    process_line(part, seen)
            elif p.poll() is not None:
                break
        selector.close()
        if p.poll() is None:
            p.terminate()
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.kill(); p.wait()
        if data:
            process_line(data, seen)
        err = p.stderr.read().decode("utf-8", "replace") if p.stderr else ""
        if p.returncode not in (0, 130, -signal.SIGINT) and "listening on" not in err:
            raise RuntimeError("tcpdump failed: " + err.strip()[-300:])
    return seen, max(0.001, time.monotonic() - start)



def native_snapshot(cam, minutes=2):
    """Report receiver/source and sender/target SRT protocol samples from Docker JSON logs.

    -stats:N uses a PACKET counter, not a time interval. These are samples from
    srt_bstats(..., clear=True); loss reports are not a measured path loss rate.
    """
    result = cmd(["docker", "logs", "--since", f"{minutes}m", "--timestamps",
                  "--tail", "1500", f"srt-cam{cam}"], timeout=8.0)
    if result is None or result.returncode != 0:
        print(f"STOP: cannot read logs for srt-cam{cam} (check container and Docker permissions)")
        return 2
    latest = {}
    for line in (result.stdout + "\n" + result.stderr).splitlines():
        head, separator, payload = line.partition(" ")
        if not separator or not payload.lstrip().startswith("{"):
            continue
        try:
            sample = json.loads(payload.strip())
        except (ValueError, TypeError):
            continue
        if not isinstance(sample, dict) or not isinstance(sample.get("link"), dict):
            continue
        recv, send = sample.get("recv"), sample.get("send")
        if not isinstance(recv, dict) or not isinstance(send, dict):
            continue
        received = float(recv.get("packets", 0) or 0)
        sent = float(send.get("packets", 0) or 0)
        side = "SOURCE" if received > sent else ("TARGET" if sent > received else None)
        if side is None:
            continue  # no media statistics, cannot classify socket
        latest[side] = (head, sample)

    print(f"CAM{cam} SRT native statistics | last {minutes}m | SOURCE=211{10+cam:02d}, TARGET=111{10+cam:02d}")
    print("Native counters are per reporting interval; -stats frequency is in MEDIA PACKETS.")
    if not latest:
        print("NO STATS: no native JSON samples observed. The source may be idle,")
        print("or -stats:N -statspf:json is not enabled on this container.")
        return 1

    def show(side, port):
        if side not in latest:
            print(f"{side:<6} UDP {port}: NO SAMPLE (not proof of disconnection)")
            return
        stamp, sample = latest[side]
        link, recv, send = sample["link"], sample["recv"], sample["send"]
        metrics = recv if side == "SOURCE" else send
        val = lambda name: metrics.get(name, "N/A")
        bitrate = metrics.get("mbitRate", "N/A")
        delay = recv.get("msTsbPdDelay", "N/A") if side == "SOURCE" else "N/A"
        print(f"{side:<6} UDP {port}  {stamp}  sid={sample.get('sid', '?')}")
        print(f"       RTT={link.get('rtt', 'N/A')}ms  rate={bitrate}Mb/s"
              f"  lost={val('packetsLost')}  retrans={val('packetsRetransmitted')}"
              f"  dropped={val('packetsDropped')}  RX_TSBPD={delay}ms")

    show("SOURCE", 21110 + cam)
    show("TARGET", 11110 + cam)
    print("SOURCE metrics = Egypt/remote -> VPS receiver; TARGET = VPS -> Shanghai sender.")
    print("Lost counts are SRT reports, NOT raw Internet loss percentage;")
    print("RTT/TSBPD are this socket's own values, NOT the other SRT hop.")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Read-only SRT relay snapshot; root required")
    ap.add_argument("-s", "--seconds", type=int, default=6, help="capture duration, default 6")
    ap.add_argument("--config", default="/etc/srt-status.json", help="optional channel labels/expected_active")
    ap.add_argument("--no-logs", action="store_true", help="skip recent RCV/SND-DROPPED log checks")
    ap.add_argument("--srt", type=int, metavar="CAM", help="show native SRT stats for one CAM (1..10); no tcpdump")
    ap.add_argument("--minutes", type=int, default=2, help="native stats search window (1..30 min)")
    args = ap.parse_args()
    if args.srt is not None:
        if not 1 <= args.srt <= 10 or not 1 <= args.minutes <= 30:
            ap.error("--srt must be 1..10 and --minutes 1..30")
        if not shutil.which("docker"):
            ap.error("missing tool: docker")
        return native_snapshot(args.srt, args.minutes)
    if args.seconds < 2 or args.seconds > 30:
        ap.error("seconds must be 2..30")
    for tool in ("docker", "tcpdump"):
        if not shutil.which(tool):
            ap.error(f"missing tool: {tool}")
    if os.geteuid() != 0:
        ap.error("run with sudo/root (tcpdump requires packet capture privileges)")
    try:
        cfg = load_config(args.config)
        expected = {int(x) for x in cfg.get("expected_active", [])}
        labels = {str(k): str(v)[:18] for k, v in cfg.get("directions", {}).items()}
        states = {n: inspect_container(n) for n in range(1, 11)}
        counters, elapsed = capture(args.seconds)
        drops = {n: recent_srt_drop(n) if not args.no_logs else "-" for n in range(1,11)}
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    print(f"SRT Gateway | {datetime.datetime.now().astimezone().strftime('%Y-%m-%d %H:%M:%S %Z')} | {args.seconds}s UDP sample")
    print("CAM  FLOW       RX Mb/s  TX Mb/s  TX PATH     EVENT  RESULT")
    print("---  ---------  -------  -------  ----------  -----  -----------------")
    for n in range(1, 11):
        record = counters[n]
        rx = record["rx"] * 8 / 1e6 / args.seconds
        tx = record["tx"] * 8 / 1e6 / args.seconds
        path = "+".join(v for v in ("WAN", "LO") if record["tx_"+v] >= 5000) or "-"
        state, restarts = states[n]
        event = drops[n]
        if state != "running":
            status = f"STOPPED({state})"
        elif rx >= .10 and tx >= .10:
            status = "FLOW"
        elif rx >= .10 and tx < .10:
            status = "CHECK OUTPUT"
        elif tx >= .10 and rx < .10:
            status = "CHECK INPUT"
        elif n in expected:
            status = "CHECK NO TRAFFIC"
        else:
            status = "IDLE/UNKNOWN"
        print(f"{n:>3}  {labels.get(str(n), '?'):<9}  {rx:7.2f}  {tx:7.2f}  {path:<10}  {event:<5}  {status}")
    print("\nRX/TX = sampled SRT UDP media-sized payload (>=500B), incl. retransmission; NOT video bitrate")
    print("EVENT=YES: recent SRT RCV/SND-DROPPED log; no logs does NOT mean loss-free")
    print("FLOW does NOT prove correct pictures. IDLE/UNKNOWN is NOT an error unless channel is expected active.")
    print("LO=SRT UDP is local to the VPS (e.g. sing-box); WAN=direct public UDP.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())

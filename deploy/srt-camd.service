[Unit]
Description=SRT-CAM v2 Control Plane & Telemetry Observer (decoupled from media data plane)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/srt-camd --config /etc/srt-cam/config.json --events /etc/srt-cam/event-sheet.json
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

# Mode B pure-Go Layer-4 UDP passthrough forwarder for Makito X4 Path Redundancy
FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/srt-passd ./cmd/srt-passd
COPY internal/srtparse ./internal/srtparse
COPY internal/passthrough ./internal/passthrough

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/srt-passd ./cmd/srt-passd

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/srt-passd /usr/local/bin/srt-passd
ENTRYPOINT ["/usr/local/bin/srt-passd"]

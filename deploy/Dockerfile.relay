# Mode A upgraded SRT relay image (Haivision libsrt 1.5.x + srt-relayd preview tap)
# - Without PREVIEW_HTTP_ADDR, srt-relayd directly execs srt-live-transmit (zero overhead).
# - With PREVIEW_HTTP_ADDR=127.0.0.1:2911x, serves an on-demand non-blocking HTTP /ts tap
#   so srt-camd can grab 1 keyframe thumbnail every 5s when the dashboard is open (0% CPU when idle).

FROM ubuntu:24.04 AS srt-builder

ARG SRT_VERSION=v1.5.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config git ca-certificates libssl-dev tclsh \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch "${SRT_VERSION}" https://github.com/Haivision/srt.git \
 && cmake -S srt -B srt/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DENABLE_APPS=ON \
      -DENABLE_BONDING=ON \
      -DENABLE_SHARED=ON \
      -DENABLE_STATIC=OFF \
      -DENABLE_UNITTESTS=OFF \
 && cmake --build srt/build -j"$(nproc)" \
 && cmake --install srt/build

FROM golang:1.26-alpine AS relayd-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/srt-relayd ./cmd/srt-relayd
COPY internal/relaytee ./internal/relaytee
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/srt-relayd ./cmd/srt-relayd

FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends libssl3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=srt-builder /usr/local/bin/srt-live-transmit /usr/local/bin/srt-live-transmit
COPY --from=srt-builder /usr/local/lib/libsrt.so* /usr/local/lib/
COPY --from=relayd-builder /out/srt-relayd /usr/local/bin/srt-relayd
RUN ldconfig

ENTRYPOINT ["/usr/local/bin/srt-relayd"]
